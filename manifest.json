{
  "action": {
    "default_icon": "images/app16.png",
    "default_popup": "content/popup.html",
    "default_title": "__MSG_appName__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "include_globs": [
        "*forgeofempires.com/game*"
      ],
      "js": [
        "js/foeproxy.js"
      ],
      "matches": [
        "https://*.forgeofempires.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "include_globs": [
        "*forgeofempires.com/game*"
      ],
      "js": [
        "js/foeproxy-fallback.js"
      ],
      "matches": [
        "https://*.forgeofempires.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "include_globs": [
        "*forgeofempires.com/game*"
      ],
      "js": [
        "vendor/browser-polyfill/browser-polyfill.min.js",
        "js/web/_languages/js/_languages.js",
        "js/inject.js"
      ],
      "matches": [
        "https://*.forgeofempires.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "externally_connectable": {
    "ids": [
      "*"
    ],
    "matches": [
      "https://*.forgeofempires.com/*"
    ]
  },
  "host_permissions": [
    "https://*.forgeofempires.com/*",
    "https://foe-helper.com/*",
    "https://*.foe-helper.com/*",
    "https://*.foe-rechner.de/*"
  ],
  "icons": {
    "128": "images/app128.png",
    "16": "images/app16.png",
    "48": "images/app48.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "name": "FoE Helper Development - Placed Buildings",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "clipboardWrite"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "4.8.7.0",
  "web_accessible_resources": [
    {
      "matches": [
        "https://*/*"
      ],
      "resources": [
        "js/*",
        "vendor/*",
        "css/*",
        "content/*"
      ]
    }
  ]
}
